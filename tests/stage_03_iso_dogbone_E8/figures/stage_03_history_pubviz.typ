#import "@preview/cetz:0.3.4"
#set page(width: 146mm, height: 96mm, margin: 4mm)
#set text(font: "Libertinus Serif", size: 8.5pt, fill: rgb("#363636"))
#let garnet = rgb("#73000A")
#let atlantic = rgb("#466A9F")
#let horseshoe = rgb("#65780B")
#let congaree = rgb("#1F414D")
#let honeycomb = rgb("#A49137")
#let rose = rgb("#CC2E40")
#let charcoal = rgb("#363636")
#let black10 = rgb("#ECECEC")
#let black50 = rgb("#A2A2A2")
#let white = rgb("#FFFFFF")
#align(center)[#text(size: 10.5pt, weight: "bold")[Dogbone Stress-Strain]]
#v(1mm)
#cetz.canvas(length: 1cm, {
  import cetz.draw: *
  rect((1.350, 0.950), (13.050, 6.300), fill: white, stroke: charcoal + 0.65pt)
  line((1.350, 0.950), (13.050, 0.950), stroke: black10 + 0.45pt)
  content((1.190, 0.950), [0], anchor: "east")
  line((1.350, 2.287), (13.050, 2.287), stroke: black10 + 0.45pt)
  content((1.190, 2.287), [81.35], anchor: "east")
  line((1.350, 3.625), (13.050, 3.625), stroke: black10 + 0.45pt)
  content((1.190, 3.625), [162.7], anchor: "east")
  line((1.350, 4.962), (13.050, 4.962), stroke: black10 + 0.45pt)
  content((1.190, 4.962), [244], anchor: "east")
  line((1.350, 6.300), (13.050, 6.300), stroke: black10 + 0.45pt)
  content((1.190, 6.300), [325.4], anchor: "east")
  line((1.350, 3.004), (1.772, 4.238), (2.058, 5.061), (13.050, 5.904), stroke: garnet + 1.05pt)
  circle((1.350, 3.004), radius: 0.045, fill: garnet, stroke: none)
  circle((1.772, 4.238), radius: 0.045, fill: garnet, stroke: none)
  circle((2.058, 5.061), radius: 0.045, fill: garnet, stroke: none)
  circle((13.050, 5.904), radius: 0.045, fill: garnet, stroke: none)
  line((1.350, 3.005), (1.772, 4.238), (2.058, 5.060), (13.050, 5.882), stroke: atlantic + 1.05pt)
  circle((1.350, 3.005), radius: 0.045, fill: atlantic, stroke: none)
  circle((1.772, 4.238), radius: 0.045, fill: atlantic, stroke: none)
  circle((2.058, 5.060), radius: 0.045, fill: atlantic, stroke: none)
  circle((13.050, 5.882), radius: 0.045, fill: atlantic, stroke: none)
  line((1.450, 6.750), (1.870, 6.750), stroke: garnet + 1.05pt)
  content((1.970, 6.750), [OpenRadioss], anchor: "west")
  line((4.550, 6.750), (4.970, 6.750), stroke: atlantic + 1.05pt)
  content((5.070, 6.750), [load/area], anchor: "west")
  content((1.350, 0.600), [0.06247], anchor: "north")
  content((13.050, 0.600), [1.103], anchor: "north")
  content((7.200, 0.300), [gauge strain (\%)], anchor: "north")
  content((0.400, 3.625), [stress (MPa)], angle: 90deg)
})
#v(0.5mm)
#text(size: 7pt, fill: rgb("#5C5C5C"))[Medium mesh load-factor sweep.]
