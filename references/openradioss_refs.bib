  author       = {{Altair Engineering, Inc.}},
  title        = {Rigid Body {/RBODY} reference},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/rigid_body_intro_r.htm}},
  note         = {Constrains a set of nodes to move together as a non-deformable body. Used for projectile / impactor representation in stages 13-16; not a periodic-BC primitive.}
}

@misc{AltairRadiossInterType2,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/INTER/TYPE2} tied interface reference},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/inter_type2_starter_r.htm}},
