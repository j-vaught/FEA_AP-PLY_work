% ===== Altair Radioss reference manual (open documentation pages) =====

@misc{AltairRadiossLAW25,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/MAT/LAW25} (COMPSH) reference: composite shell and solid material with Tsai-Wu and CRASURV formulations},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/law25_composite_material_r.htm}},
  note         = {Reference for the most-used composite material in Radioss / OpenRadioss. Compatible with shell properties (TYPE10, TYPE11, TYPE17, TYPE51, PCOMPP) and solid properties (TYPE6, TYPE14, TYPE20, TYPE21, TYPE22). Failure cards \texttt{/FAIL/CHANG}, \texttt{/FAIL/HASHIN}, \texttt{/FAIL/PUCK}, \texttt{/FAIL/LAD\_DAMA} apply on solid elements.}
}

@misc{AltairRadiossLAW12LAW14,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/MAT/LAW12} (3D\_COMP) and {/MAT/LAW14} (COMPSO) reference: 3D orthotropic-elastic Tsai-Wu for solids},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/law12_and_law14_composite_material_r.htm}},
  note         = {LAW12 supersedes LAW14 as the documented preferred 3D composite solid card. Both are 3D orthotropic-elastic before the Tsai-Wu criterion is reached, with 9-parameter orthotropic stiffness. Solid-only.}
}

@misc{AltairRadiossCompositeIntro,
