}

@misc{AltairRadiossInterType7,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/INTER/TYPE7} general node-to-surface penalty contact},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/inter_type7_starter_r.htm}},
  note         = {Multi-usage impact contact interface using the penalty method. Standard contact for projectile-laminate and tow-matrix interfaces in stages 13-16.}
}

@misc{AltairRadiossLAW2,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/MAT/LAW2} (PLAS\_JOHNS): Johnson-Cook elasto-plastic model for bricks, shells, trusses, beams},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/mat_law2_plas_johns_starter_r.htm}},
  note         = {Standard Johnson-Cook plasticity card. Solid (brick) compatible. Used in stage 3 (isotropic dogbone tension).}
}

@misc{AltairRadiossLAW36,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/MAT/LAW36} (PLAS\_TAB): tabulated piecewise-linear elasto-plastic material model},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/mat_law36_plas_tab_starter_r.htm}},
  note         = {Tabulated isotropic elasto-plastic law for bricks, shells, trusses, and beams. Hardening curve supplied as one or more user-defined functions $\sigma_y(\bar{\varepsilon}^p)$, optionally with strain-rate dependence. Solid (\texttt{/PROP/TYPE14}) compatible. Used as the rate-independent alternative to \texttt{/MAT/LAW2} in stage 3 (isotropic dogbone tension) when an experimentally measured $\sigma$-$\varepsilon$ curve is available rather than Johnson-Cook coefficients.}
}

@misc{AltairRadiossImplLinear,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/IMPL/LINEAR}: linear-static implicit computation},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/impl_linear_starter_r.htm}},
  note         = {Activates a single-step linear-static implicit solve in OpenRadioss. Requires the MUMPS-linked implicit build. Used in stage 1 (linear-elastic beam) and as the elastic ramp portion of stage 3.}
}

@misc{AltairRadiossImplQstat,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/IMPL/QSTAT}: quasi-static implicit non-linear computation},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/impl_qstat_starter_r.htm}},
  note         = {Quasi-static implicit nonlinear solver in OpenRadioss. Used for displacement-controlled elasto-plastic ramps such as stage 3 (isotropic dogbone tension) past yield.}
}

@misc{AltairRadiossBCS,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/BCS}: nodal boundary conditions reference},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/bcs_starter_r.htm}},
  note         = {General nodal boundary-condition card for translational and rotational DOF restraints. Used to clamp the fixed grip face and to suppress lateral DOFs on the loaded grip face in stage 3.}
}

@misc{AltairRadiossImpDisp,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/IMPDISP}: imposed displacement reference},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/imposed_displacement_r.htm}},
  note         = {Imposed-displacement loading card driven by a function of time. Used to ramp the loaded grip face axially for displacement-controlled tensile coupon analyses (stage 3).}
}

@misc{AltairRadiossTH,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/TH/NODE} and {/TH/BRICK}: time-history output for nodes and solid elements},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/th_node_starter_r.htm}},
  note         = {Time-history output cards. \texttt{/TH/NODE} writes nodal displacement, velocity, and reaction-force histories to the \texttt{T01} file; \texttt{/TH/BRICK} writes per-element stress, plastic strain, and damage histories. Used in stage 3 to extract the gauge-section $\sigma$-$\varepsilon$ curve and the grip reaction force.}
}

@misc{AltairRadiossDuctileDamage,
