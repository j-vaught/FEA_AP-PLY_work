}

@misc{AltairRadiossFailHashin,
  author       = {{Altair Engineering, Inc.}},
  title        = {{/FAIL/HASHIN} reference},
  year         = {2025},
  howpublished = {\url{https://help.altair.com/hwsolvers/rad/topics/solvers/rad/fail_hashin_starter_r.htm}},
