% Hill-Mandel uniform-displacement homogenization (justifies the validation strategy in §7c)

@article{Hill1963Elastic,
  author    = {Hill, R.},
  title     = {Elastic properties of reinforced solids: some theoretical principles},
  journal   = {Journal of the Mechanics and Physics of Solids},
  volume    = {11},
  number    = {5},
  pages     = {357--372},
  year      = {1963},
  doi       = {10.1016/0022-5096(63)90036-X},
  note      = {The Hill condition Sigma : eps = <sigma : eps> bounds the uniform-displacement and uniform-traction estimates of the homogenized stiffness. The 5-10\% bias documented in tests/stage_11_PW_mesoscale_direct/spec.md §1.2 traces to this paper.}
}

% Lomov 2007 textile-FE convergence (cited by stage 11 spec §1.2 to justify the uniform-displacement window)

@article{Lomov2007Meso,
  author    = {Lomov, S.V. and Ivanov, D.S. and Verpoest, I. and Zako, M. and Kurashiki, T. and Nakai, H. and Hirosawa, S.},
  title     = {Meso-{FE} modelling of textile composites: Road map, data flow and algorithms},
  journal   = {Composites Science and Technology},
  volume    = {67},
  number    = {9},
  pages     = {1870--1891},
  year      = {2007},
  doi       = {10.1016/j.compscitech.2006.10.017},
  note      = {Documents the convergence of uniform-displacement and periodic homogenization for textile composites as the specimen-to-unit-cell ratio grows. The 4-period rule used in stage 11 traces here.}
}

% Espadas-Escalante 2017 BC effect on textile homogenization

@article{EspadasEscalante2017BC,
  author    = {Espadas-Escalante, J.J. and van Dijk, N.P. and Isaksson, P.},
  title     = {A study on the influence of boundary conditions in computational homogenization of periodic structures with application to woven composites},
  journal   = {Composite Structures},
  volume    = {160},
  pages     = {529--537},
  year      = {2017},
  doi       = {10.1016/j.compstruct.2016.10.082},
  note      = {Quantifies the bias between uniform-displacement, uniform-traction, and periodic BCs as a function of unit-cell count. Used by plan/kok_port_plan.md §7c to bound the validation tolerance.}
}

